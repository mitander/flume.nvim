#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

# Check Lua formatting and behavior.
stylua --check --verify .
nvim --headless --clean -c "lua dofile('tests/run.lua')"

# Reject whitespace errors.
git diff --check

python3 scripts/check-whitespace.py

# Check script syntax without running snapshot fixtures.
sh -n scripts/check
bash -n tests/fish-tools.sh
python3 -m py_compile \
  scripts/check-links.py scripts/check-whitespace.py scripts/preflight-screenshots.py \
  scripts/review-integrations.py scripts/snapshots scripts/native-themes tests/snapshots/*.py
for fixture_script in tests/snapshots/fixtures/*.sh; do
  sh -n "$fixture_script"
done

# Validate documentation and screenshot provenance.
python3 scripts/check-links.py
python3 scripts/preflight-screenshots.py --source-only
python3 scripts/preflight-screenshots.py

# Run Python tests.
python3 -m unittest discover -s tests -p 'check_whitespace.py'
python3 -m unittest discover -s tests -p 'documentation_links.py'
python3 -m unittest discover -s tests -p 'examples.py'
python3 -m unittest discover -s tests -p 'screenshots.py'
python3 -m unittest discover -s tests -p 'integration_review.py'
python3 -m unittest discover -b -s tests -p 'snapshot_commands.py'
python3 -m unittest discover -b -s tests -p 'native_themes.py'
