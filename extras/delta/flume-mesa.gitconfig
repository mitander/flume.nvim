# Generated by Flume.
[delta]
    light = true
    features = flume
    syntax-theme = ansi

[delta "flume"]
    minus-style = syntax "#ead9e2"
    minus-emph-style = syntax "#d9c0cc"
    plus-style = syntax "#dce5e0"
    plus-emph-style = syntax "#c4d5ce"
    line-numbers = true
    line-numbers-minus-style = "#89455f"
    line-numbers-plus-style = "#43615a"
    line-numbers-left-style = "#89818d"
    line-numbers-right-style = "#89818d"
    commit-decoration-style = "#2f6271" box
    file-style = "#524f50"
    file-decoration-style = "#2f6271" ul
    hunk-header-style = "#524f50"
    hunk-header-decoration-style = "#89818d" box
