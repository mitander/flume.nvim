# Generated by Flume.
[delta]
    light = false
    features = flume
    syntax-theme = ansi

[delta "flume"]
    minus-style = syntax "#3b292d"
    minus-emph-style = syntax "#70434b"
    plus-style = syntax "#29342c"
    plus-emph-style = syntax "#455f4a"
    line-numbers = true
    line-numbers-minus-style = "#ee9da7"
    line-numbers-plus-style = "#b9cba5"
    line-numbers-left-style = "#484a55"
    line-numbers-right-style = "#484a55"
    commit-decoration-style = "#98c4d0" box
    file-style = "#cac7d3"
    file-decoration-style = "#98c4d0" ul
    hunk-header-style = "#cac7d3"
    hunk-header-decoration-style = "#484a55" box
