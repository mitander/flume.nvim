# Generated by Flume.
[delta]
    light = false
    features = flume
    syntax-theme = ansi

[delta "flume"]
    minus-style = syntax "#352b31"
    minus-emph-style = syntax "#6c4856"
    plus-style = syntax "#29312e"
    plus-emph-style = syntax "#465f54"
    line-numbers = true
    line-numbers-minus-style = "#cc91a5"
    line-numbers-plus-style = "#95b0a2"
    line-numbers-left-style = "#494c58"
    line-numbers-right-style = "#494c58"
    commit-decoration-style = "#8caabd" box
    file-style = "#bdc0c8"
    file-decoration-style = "#8caabd" ul
    hunk-header-style = "#bdc0c8"
    hunk-header-decoration-style = "#494c58" box
