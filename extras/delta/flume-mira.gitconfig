# Generated by Flume.
[delta]
    light = false
    features = flume
    syntax-theme = ansi

[delta "flume"]
    minus-style = syntax "#402a35"
    minus-emph-style = syntax "#754355"
    plus-style = syntax "#2a3735"
    plus-emph-style = syntax "#47665d"
    line-numbers = true
    line-numbers-minus-style = "#dd789b"
    line-numbers-plus-style = "#84b39f"
    line-numbers-left-style = "#4b485a"
    line-numbers-right-style = "#4b485a"
    commit-decoration-style = "#72b5bf" box
    file-style = "#d9d4df"
    file-decoration-style = "#72b5bf" ul
    hunk-header-style = "#d9d4df"
    hunk-header-decoration-style = "#4b485a" box
