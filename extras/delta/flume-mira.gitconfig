# Generated by Flume.
[delta]
    light = false
    features = flume
    syntax-theme = ansi

[delta "flume"]
    minus-style = syntax "#38303b"
    minus-emph-style = syntax ul "#3d333e"
    plus-style = syntax "#2c3337"
    plus-emph-style = syntax ul "#30383b"
    line-numbers = true
    line-numbers-minus-style = "#ec929b"
    line-numbers-plus-style = "#9cbeac"
    line-numbers-left-style = "#515568"
    line-numbers-right-style = "#515568"
    commit-decoration-style = "#95bbc9" box
    file-style = "#cbcccf"
    file-decoration-style = "#95bbc9" ul
    hunk-header-style = "#cbcccf"
    hunk-header-decoration-style = "#515568" box
